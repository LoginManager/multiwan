[Unit]
Description=MultiWAN web panel
After=network.target
[Service]
# نقرأ multiwan.conf عبر bash (لا عبر EnvironmentFile) لأن systemd لا يحذف التعليق بعد القيمة
ExecStart=/bin/bash -c 'set -a; . /etc/multiwan/multiwan.conf; exec /usr/bin/python3 /opt/multiwan/app.py'
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
